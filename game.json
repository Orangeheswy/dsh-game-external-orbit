{
  "manifestVersion": 1,
  "id": "external-orbit",
  "name": "External Orbit",
  "version": "1.0.0",
  "author": { "name": "Orangeheswy" },
  "description": "Controlled external-author submission: a multi-file orbit arcade run used to verify the community publishing, review, install, update and withdrawal loop.",
  "categories": ["arcade"],
